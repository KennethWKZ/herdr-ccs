#!/bin/sh
# herdr-ccs — integrate `ccs claude` with Herdr, on top of the built-in Claude Code integration.
#
# `ccs claude` wraps Claude Code in the ccs launcher (a proxy/router). Herdr sees the
# foreground process as `node`/`ccs`, not `claude`, so it neither detects the agent nor
# resumes it through ccs. This tool fixes both, without disturbing native `claude` use.
#
# What it installs:
#   1. A PATH shim (~/.herdr-shims/claude) that:
#        - exports HERDR_AGENT=claude so a ccs-wrapped pane is detected as Claude Code
#        - on `--resume <id>`, routes through `ccs <profile> [--browser] --resume` iff <id>
#          was a ccs-started session, else runs the real claude binary (native stays native)
#   2. A PATH shim (~/.herdr-shims/ccs) that starts the ccs-managed Chrome before a
#      `--browser` launch, and quits it when the last `--browser` session using it exits.
#      ccs only exposes its browser MCP tools when Chrome already answers on the DevTools
#      port at launch, and never starts Chrome itself.
#   3. A Claude Code SessionStart hook that tags ccs-started sessions
#      (detected via ANTHROPIC_AUTH_TOKEN=ccs-internal-managed) under the shim's markers dir,
#      recording the ccs profile and whether browser tools were live, so resume replays both.
#   4. Two lines in your shell profile: a PATH line so the shims resolve ahead of the real
#      binaries, and a CCS_CLAUDE_PATH export that pins ccs to the real claude — so a direct
#      `ccs claude --resume` finds it in one hop instead of bouncing back through the shim.
#
# Idempotent and reversible. Fresh `claude` and native `--resume` exec the real binary
# unchanged, so the shim is transparent for non-ccs use.
#
# Usage: herdr-ccs install | uninstall [--purge] | status
#
# Env overrides: HERDR_CCS_SHIM_DIR, HERDR_CCS_PROFILE, HERDR_CCS_REAL_CLAUDE, CLAUDE_CONFIG_DIR

set -eu

SHIM_DIR="${HERDR_CCS_SHIM_DIR:-$HOME/.herdr-shims}"
SHIM="$SHIM_DIR/claude"
CCS_SHIM="$SHIM_DIR/ccs"
MARK_DIR="$SHIM_DIR/ccs-sessions"
BROWSER_DIR="$SHIM_DIR/browser"
CFG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
HOOK="$CFG_DIR/hooks/ccs-session-marker.sh"
SETTINGS="$CFG_DIR/settings.json"
MARKER_BIN="$SHIM_DIR/bin/herdr-ccs-marker"
# Where `[[build]]` (bin/build-marker.sh) leaves the Rust marker inside the plugin folder.
MARKER_BUILD="${HERDR_CCS_MARKER_BUILD:-$(cd "$(dirname "$0")/.." && pwd)/marker/target/release/herdr-ccs-marker}"
HOOK_CMD="bash '$HOOK'"
BEGIN="# >>> herdr-ccs shim >>>"
END="# <<< herdr-ccs shim <<<"

log()  { printf '%s\n' "$*"; }
warn() { printf 'herdr-ccs: %s\n' "$*" >&2; }
die()  { printf 'herdr-ccs: %s\n' "$*" >&2; exit 1; }

# Rewrite a path under $HOME as a literal "$HOME/..." string, so lines written into a shell
# profile stay portable across machines/dotfile repos instead of baking an absolute home path.
homeify() { # $1 = absolute path
  case "$1" in
    "$HOME"/*) printf '$HOME/%s\n' "${1#"$HOME"/}" ;;
    "$HOME")   printf '$HOME\n' ;;
    *)         printf '%s\n' "$1" ;;
  esac
}

python_bin() {
  if   command -v python3 >/dev/null 2>&1; then echo python3
  elif command -v python  >/dev/null 2>&1; then echo python
  else return 1; fi
}

# Resolve the real claude binary, never the shim. Prints path on stdout, empty if none.
detect_real_claude() {
  for c in "${HERDR_CCS_REAL_CLAUDE:-}" "${CCS_CLAUDE_PATH:-}"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  npmbin=""
  command -v npm >/dev/null 2>&1 && npmbin="$(npm prefix -g 2>/dev/null)/bin/claude"
  for c in "$HOME/.local/bin/claude" /opt/homebrew/bin/claude /usr/local/bin/claude "$npmbin"; do
    [ -n "$c" ] || continue
    case "$c" in "$SHIM_DIR"/*) continue ;; esac
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  if command -v which >/dev/null 2>&1; then
    which -a claude 2>/dev/null | while IFS= read -r c; do
      case "$c" in "$SHIM_DIR"/*) continue ;; esac
      [ -x "$c" ] && { printf '%s\n' "$c"; break; }
    done | head -n1
  fi
}

# Resolve the real ccs on PATH, never the shim. Prints path on stdout, empty if none.
detect_real_ccs() {
  command -v which >/dev/null 2>&1 || return 0
  which -a ccs 2>/dev/null | while IFS= read -r c; do
    case "$c" in "$SHIM_DIR"/*) continue ;; esac
    [ -x "$c" ] && { printf '%s\n' "$c"; break; }
  done | head -n1
}

# Resolve the shell profile that a Herdr interactive pane shell will source.
detect_profile() {
  if [ -n "${HERDR_CCS_PROFILE:-}" ]; then printf '%s\n' "$HERDR_CCS_PROFILE"; return 0; fi
  case "$(basename "${SHELL:-}")" in
    zsh)  printf '%s\n' "$HOME/.zshrc"  ;;
    bash) printf '%s\n' "$HOME/.bashrc" ;;
    *)    return 1 ;;
  esac
}

write_shim() { # $1 = real claude path
  real="$1"
  mkdir -p "$SHIM_DIR" "$MARK_DIR"
  cat > "$SHIM" <<EOF
#!/bin/sh
# Managed by herdr-ccs. Do not edit; run \`herdr-ccs install\` to regenerate.
REAL="\${HERDR_CCS_REAL_CLAUDE:-$real}"
MARK_DIR="$MARK_DIR"

id=""; prev=""
for a in "\$@"; do
  case "\$prev" in --resume|-r) id="\$a";; esac
  case "\$a" in --resume=*) id="\${a#--resume=}";; esac
  prev="\$a"
done

export HERDR_AGENT=claude   # detected as Claude Code in a Herdr pane; harmless outside

if [ -n "\$id" ] && [ -f "\$MARK_DIR/\$id" ] && command -v ccs >/dev/null 2>&1; then
  export CCS_CLAUDE_PATH="\$REAL"   # ccs resolves the real binary; never re-enters this shim
  # Markers written before profile capture are empty: resume them as \`ccs claude\`, as before.
  profile="\$(sed -n 's/^profile=//p' "\$MARK_DIR/\$id" | head -n1)"
  if grep -qx 'browser=1' "\$MARK_DIR/\$id"; then
    exec ccs "\${profile:-claude}" --browser "\$@"
  fi
  exec ccs "\${profile:-claude}" "\$@"
fi
exec "\$REAL" "\$@"                  # fresh session, or native session -> real claude
EOF
  chmod +x "$SHIM"
}

write_ccs_shim() {
  mkdir -p "$SHIM_DIR"
  { printf '#!/bin/sh\n# Managed by herdr-ccs. Do not edit; run `herdr-ccs install` to regenerate.\n'
    printf "SHIM_DIR='%s'\n" "$SHIM_DIR"
    printf "BROWSER_DIR='%s'\n" "$BROWSER_DIR"
    cat <<'EOF'
# ccs only exposes its browser MCP tools when Chrome already answers on the DevTools port at
# launch, and never starts Chrome itself — so bring the managed Chrome up before a
# `--browser` launch, and quit it again once the last `--browser` session that needed it
# exits. Everything else passes straight through to the real ccs.

real=""
ifs=$IFS; IFS=:; set -f
for d in $PATH; do
  case "$d" in ''|"$SHIM_DIR") continue ;; esac
  [ -x "$d/ccs" ] && ! [ "$d/ccs" -ef "$0" ] && { real="$d/ccs"; break; }
done
IFS=$ifs; set +f
[ -n "$real" ] || { echo "herdr-ccs: no real ccs found on PATH" >&2; exit 127; }

# Same precedence as ccs: CCS_DIR, then CCS_HOME/.ccs, then ~/.ccs.
ccs_dir="${CCS_DIR:-${CCS_HOME:+$CCS_HOME/.ccs}}"
ccs_dir="${ccs_dir:-$HOME/.ccs}"

cfg_value() { # $1 = key under browser.claude in config.yaml
  [ -f "$ccs_dir/config.yaml" ] || return 0
  awk -v key="$1:" '
    /^[^[:space:]#]/ { b = ($0 ~ /^browser:/); c = 0; next }
    b && /^  [^[:space:]#]/ { c = ($0 ~ /^  claude:/); next }
    b && c && $1 == key { sub(/^[^:]*:[[:space:]]*/, ""); gsub(/^["\047]|["\047]$/, ""); print; exit }
  ' "$ccs_dir/config.yaml"
}

launch_chrome() { # $1 = port, $2 = user-data dir
  case "$(uname -s)" in
    Darwin) open -gna "Google Chrome" --args --remote-debugging-port="$1" --user-data-dir="$2" ;;
    *)
      for b in google-chrome google-chrome-stable chromium chromium-browser; do
        command -v "$b" >/dev/null 2>&1 || continue
        nohup "$b" --remote-debugging-port="$1" --user-data-dir="$2" >/dev/null 2>&1 &
        return 0
      done
      return 1
      ;;
  esac
}

# Per-port state in $BROWSER_DIR/<port>: one lease file per running `--browser` shim (named by
# its PID), plus `owned` (holding the user-data dir) when this shim started that Chrome. Only an
# owned Chrome is ever closed, so a Chrome you opened yourself is left alone.
state=""
held=0
starting=0   # 1 between launching Chrome and it answering on the port

lock() { # mkdir is atomic; a lock left by a killed shim is broken after ~12s
  i=0
  until mkdir "$state/lock" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -ge 120 ] && break
    sleep 0.1
  done
  held=1
}
unlock() { rmdir "$state/lock" 2>/dev/null || true; held=0; }

ensure_browser() {
  [ "$(cfg_value enabled)" = "false" ] && return 0
  command -v curl >/dev/null 2>&1 || { echo "herdr-ccs: curl not found; not starting Chrome" >&2; return 0; }
  dir="${CCS_BROWSER_USER_DATA_DIR:-${CCS_BROWSER_PROFILE_DIR:-$(cfg_value user_data_dir)}}"
  port="${CCS_BROWSER_DEVTOOLS_PORT:-$(cfg_value devtools_port)}"
  port="${port:-9222}"
  case "$dir" in "~"/*) dir="$HOME/${dir#"~/"}" ;; esac
  probe="http://127.0.0.1:$port/json/version"

  state="$BROWSER_DIR/$port"
  mkdir -p "$state/leases" || { state=""; return 0; }
  lock
  : > "$state/leases/$$"
  curl -sf -m 1 "$probe" >/dev/null 2>&1 && { unlock; return 0; }
  # Nothing answers, so any `owned` marker is stale (that Chrome was quit or crashed).
  rm -f "$state/owned"
  # With no managed dir ccs falls back to your everyday Chrome profile; never open that one
  # to DevTools unattended.
  if [ -z "$dir" ]; then
    echo "herdr-ccs: no browser user_data_dir configured; run \`ccs browser setup\`" >&2
    unlock; return 0
  fi
  launch_chrome "$port" "$dir" || { echo "herdr-ccs: could not start Chrome" >&2; unlock; return 0; }
  printf '%s\n' "$dir" > "$state/owned"
  starting=1
  # Hold the lock while Chrome comes up, so a parallel `--browser` launch doesn't start a second one.
  i=0
  while [ "$i" -lt 40 ]; do
    curl -sf -m 1 "$probe" >/dev/null 2>&1 && { starting=0; unlock; return 0; }
    sleep 0.25
    i=$((i + 1))
  done
  starting=0
  unlock
  echo "herdr-ccs: Chrome did not answer on 127.0.0.1:$port within 10s; browser tools will be missing" >&2
}

chrome_pids() { # $1 = port, $2 = user-data dir; the browser process only, not its helpers
  ps -A -o pid= -o args= | P="--remote-debugging-port=$1 " D="--user-data-dir=$2 " awk '
    { s = $0 " " }
    index(s, ENVIRON["P"]) && index(s, ENVIRON["D"]) && !index(s, "--type=") { print $1 }'
}

close_chrome() { # $1 = port, $2 = user-data dir; SIGTERM lets Chrome shut down cleanly
  pids="$(chrome_pids "$1" "$2")"
  # `open -gna` returns before Chrome's process exists, so a session ended mid-launch waits for it.
  i=0
  while [ -z "$pids" ] && [ "$starting" -eq 1 ] && [ "$i" -lt 40 ]; do
    sleep 0.25; i=$((i + 1))
    pids="$(chrome_pids "$1" "$2")"
  done
  # shellcheck disable=SC2086 # one PID per word
  [ -z "$pids" ] || kill -TERM $pids 2>/dev/null || true
}

# shellcheck disable=SC2329 # runs from the EXIT trap
release_browser() {
  trap '' HUP INT TERM   # a second signal (a closing terminal sends several) must not cut this short
  [ -n "$state" ] || return 0
  [ "$held" -eq 1 ] || lock   # a signal can land while ensure_browser holds the lock
  rm -f "$state/leases/$$"
  for f in "$state/leases"/*; do
    [ -e "$f" ] || continue
    if kill -0 "${f##*/}" 2>/dev/null; then unlock; return 0; fi
    rm -f "$f"   # lease of a shim that died without cleaning up
  done
  if [ -f "$state/owned" ]; then
    close_chrome "${state##*/}" "$(cat "$state/owned")"
    rm -f "$state/owned"
  fi
  unlock
}

browser=0
for a in "$@"; do
  case "$a" in
    --) break ;;
    --browser) browser=1; break ;;
  esac
done
[ "$browser" -eq 1 ] || exec "$real" "$@"

# A `--browser` session holds a lease: stay alive as ccs's parent to release it on exit. The
# traps go in first, so a hangup while Chrome is still starting doesn't leave it running.
trap release_browser EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
ensure_browser
if [ -z "$state" ]; then trap - EXIT HUP INT TERM; exec "$real" "$@"; fi
"$real" "$@"
exit $?
EOF
  } > "$CCS_SHIM.tmp.$$"
  chmod +x "$CCS_SHIM.tmp.$$"
  # Replace, never rewrite in place: a running `--browser` shim is still reading its script.
  mv -f "$CCS_SHIM.tmp.$$" "$CCS_SHIM"
}

# The Rust marker, when [[build]] made one: copied out of the plugin folder (herdr replaces that folder on each
# update and later deletes the old one), so the hook always finds it at the same path. A stale copy is removed
# when there's no build, so hook and binary never come from different versions.
install_marker() {
  if [ -x "$MARKER_BUILD" ]; then
    mkdir -p "$(dirname "$MARKER_BIN")"
    cp "$MARKER_BUILD" "$MARKER_BIN.tmp.$$" && chmod 755 "$MARKER_BIN.tmp.$$"
    mv -f "$MARKER_BIN.tmp.$$" "$MARKER_BIN"   # replace, never rewrite a binary that may be running
    echo "rust"
  else
    rm -f "$MARKER_BIN"
    echo "shell (no Rust build: install cargo and reinstall the plugin for the fast marker)"
  fi
}

write_hook() {
  mkdir -p "$(dirname "$HOOK")" "$MARK_DIR"
  { printf '#!/bin/sh\n# Managed by herdr-ccs. Tags ccs-started Claude Code sessions for launcher-aware restore.\n'
    printf "MARK_DIR='%s'\n" "$MARK_DIR"
    printf "MARKER_BIN='%s'\n" "$MARKER_BIN"
    cat <<'EOF'
# The Rust marker (built at plugin install when cargo is there) does all of this in a few milliseconds; the
# shell below is the fallback.
[ -x "$MARKER_BIN" ] && exec "$MARKER_BIN" "$MARK_DIR"
input="$(cat)"
[ "${ANTHROPIC_AUTH_TOKEN:-}" = "ccs-internal-managed" ] || exit 0
# session_id from the hook input, in plain sh: no python3 (on a Mac without the Command Line Tools,
# /usr/bin/python3 is a stub that opens an install dialog and the session went untagged). Claude Code's
# session ids are UUIDs, and the id names a file under MARK_DIR, so only [A-Za-z0-9-] is accepted; a key
# inside another string value is preceded by \" and never matches.
sid="$(printf '%s' "$input" | tr '\n\r' '  ' \
  | sed -n 's/.*[{,][[:space:]]*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9-]\{1,128\}\)".*/\1/p' \
  | head -n 1)"
[ -n "$sid" ] || exit 0

# ccs exports no profile name, so read it off the launching `ccs <profile> ...` process: up to 8 parents,
# where argv[0] or argv[1] is the ccs binary (claude's own argv carries free text), then the first argument not
# starting with -. One ps for the whole process table, walked in awk: a ps per parent cost 0.1-0.5 s each here.
profile="$(ps -A -o pid=,ppid=,args= 2>/dev/null | awk -v start="$PPID" '
  { pid = $1; ppid[pid] = $2; $1 = ""; $2 = ""; args[pid] = $0 }
  END {
    p = start
    for (level = 0; level < 8; level++) {
      if (p == "" || p == 0 || p == 1 || !(p in args)) exit
      n = split(args[p], w, /[ \t]+/)
      k = 0; for (i = 1; i <= n; i++) if (w[i] != "") word[++k] = w[i]
      if (word[1] ~ /(^|\/)ccs$/) first = 2
      else if (k >= 2 && word[2] ~ /(^|\/)ccs$/) first = 3
      else { p = ppid[p]; delete word; continue }
      for (i = first; i <= k; i++) if (word[i] !~ /^-/) { print word[i]; exit }
      exit
    }
  }')"
case "$profile" in *[!A-Za-z0-9._-]*) profile="" ;; esac

mkdir -p "$MARK_DIR"
{ [ -z "$profile" ] || printf 'profile=%s\n' "$profile"
  # Set by ccs only when the browser MCP was actually exposed to this session.
  [ -z "${CCS_BROWSER_DEVTOOLS_HTTP_URL:-}" ] || printf 'browser=1\n'
} > "$MARK_DIR/$sid"
exit 0
EOF
  } > "$HOOK"
  chmod +x "$HOOK"
}

patch_settings() { # $1 = add|remove
  PY="$(python_bin)" || die "python3 required to edit settings.json"
  [ -f "$SETTINGS" ] || { mkdir -p "$CFG_DIR"; printf '{}\n' > "$SETTINGS"; }
  "$PY" - "$1" "$SETTINGS" "$HOOK_CMD" <<'PY'
import copy, json, shutil, sys
action, path, cmd = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path, encoding="utf-8") as f:
    data = json.load(f)
before = copy.deepcopy(data)
hooks = data.setdefault("hooks", {})
arr = hooks.setdefault("SessionStart", [])

def present():
    return any(h.get("command") == cmd for g in arr for h in g.get("hooks", []))

if action == "add":
    if not present():
        arr.append({"hooks": [{"type": "command", "command": cmd, "timeout": 10}]})
else:  # remove — strip only our command, preserve any co-located hooks
    kept = []
    for g in arr:
        hs = [h for h in g.get("hooks", []) if h.get("command") != cmd]
        if hs:
            g = dict(g); g["hooks"] = hs; kept.append(g)
    arr[:] = kept
    if not arr:
        hooks.pop("SessionStart", None)
    if not hooks:
        data.pop("hooks", None)

if data == before:
    sys.exit(0)  # hook already in the wanted state: leave settings.json untouched
shutil.copyfile(path, path + ".herdr-ccs.bak")
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
PY
}

add_path() { # $1 = profile, $2 = real claude path
  prof="$1"; real="$2"
  shim_disp="$(homeify "$SHIM_DIR")"
  real_disp="$(homeify "$real")"
  if grep -qF "$BEGIN" "$prof" 2>/dev/null; then
    # Block present. Ensure the CCS_CLAUDE_PATH export exists; refresh a pre-export block if not.
    grep -qF 'export CCS_CLAUDE_PATH=' "$prof" 2>/dev/null && return 0
    remove_path "$prof"
  fi
  { printf '\n%s\n' "$BEGIN"
    printf 'export PATH="%s:$PATH"\n' "$shim_disp"
    printf 'export CCS_CLAUDE_PATH="%s"\n' "$real_disp"
    printf '%s\n' "$END"
  } >> "$prof"
}

remove_path() { # $1 = profile
  prof="$1"
  [ -f "$prof" ] || return 0
  tmp="$(mktemp)"
  awk -v b="$BEGIN" -v e="$END" '
    $0==b { skip=1; next }
    $0==e { skip=0; next }
    skip!=1 { print }
  ' "$prof" > "$tmp"
  cat "$tmp" > "$prof"
  rm -f "$tmp"
}

herdr_precheck() {
  command -v herdr >/dev/null 2>&1 || { warn "herdr not found on PATH — install Herdr first"; return; }
  herdr integration status 2>/dev/null | grep -qi claude \
    || warn "Herdr's Claude integration may be missing — run: herdr integration install claude"
}

cmd_install() {
  real="$(detect_real_claude || true)"
  [ -n "$real" ] || die "could not locate the real 'claude' binary; set HERDR_CCS_REAL_CLAUDE=/path/to/claude"
  prof="$(detect_profile)" || die "unsupported shell '${SHELL:-?}'. Set HERDR_CCS_PROFILE=/path/to/profile (POSIX 'export PATH' syntax), or add '$SHIM_DIR' to PATH manually."
  [ -n "$(detect_real_ccs)" ] || warn "'ccs' not on PATH — install ccs before starting ccs sessions"
  write_shim "$real"
  write_ccs_shim
  marker_kind="$(install_marker)"
  write_hook
  patch_settings add
  if grep -qF 'export CCS_CLAUDE_PATH=' "$prof" 2>/dev/null; then prof_note="block already present"
  else prof_note="PATH + CCS_CLAUDE_PATH block appended"; fi
  add_path "$prof" "$real"
  herdr_precheck
  log "installed."
  log "  shim:        $SHIM  (real claude: $real)"
  log "  ccs shim:    $CCS_SHIM  (starts Chrome for --browser, quits it after the last one)"
  log "  marker hook: $HOOK  (marker: $marker_kind)"
  log "  settings:    $SETTINGS  (backup on change: $SETTINGS.herdr-ccs.bak)"
  log "  profile:     $prof  ($prof_note)"
  log ""
  log "next: open a new shell (or: source '$prof'), then verify:"
  log "  which claude   # expect: $SHIM"
}

cmd_uninstall() {
  purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  [ -f "$SETTINGS" ] && patch_settings remove || true
  prof="$(detect_profile 2>/dev/null || true)"
  if [ -n "$prof" ]; then
    remove_path "$prof"
  else
    warn "shell profile not auto-detected; remove the '$BEGIN' block manually if present"
  fi
  rm -f "$SHIM" "$CCS_SHIM" "$HOOK" "$MARKER_BIN"
  rmdir "$(dirname "$MARKER_BIN")" 2>/dev/null || true
  if [ "$purge" -eq 1 ]; then
    rm -rf "$MARK_DIR" "$BROWSER_DIR"
    rmdir "$SHIM_DIR" 2>/dev/null || true
    log "uninstalled (purged shim dir + session markers)."
  else
    log "uninstalled. session markers kept at $MARK_DIR (use --purge to remove)."
  fi
  [ -n "$prof" ] && log "reload your shell so PATH drops the shim: source '$prof' (or open a new shell)."
}

cmd_status() {
  mark() { if [ -n "$1" ]; then log "  [ok]  $2"; else log "  [--]  $2"; fi; }
  real="$(detect_real_claude || true)"
  real_ccs="$(detect_real_ccs)"
  prof="$(detect_profile 2>/dev/null || echo '(unsupported shell)')"
  log "herdr-ccs status:"
  mark "$( [ -x "$SHIM" ] && echo x || true )"                          "shim            $SHIM"
  mark "$( [ -x "$CCS_SHIM" ] && echo x || true )"                      "ccs shim        $CCS_SHIM"
  mark "$( [ -x "$HOOK" ] && echo x || true )"                          "marker hook     $HOOK"
  mark "$( [ -x "$MARKER_BIN" ] && echo x || true )"                    "rust marker     $MARKER_BIN$( [ -x "$MARKER_BIN" ] || echo '  (shell fallback in use)')"
  mark "$( grep -qF "$HOOK" "$SETTINGS" 2>/dev/null && echo x || true )" "SessionStart    $SETTINGS"
  mark "$( grep -qF "$BEGIN" "$prof" 2>/dev/null && echo x || true )"    "profile PATH    $prof"
  mark "$( grep -qF 'export CCS_CLAUDE_PATH=' "$prof" 2>/dev/null && echo x || true )" "profile ENV     CCS_CLAUDE_PATH pin"
  mark "$( [ -n "$real" ] && echo x || true )"                          "real claude     ${real:-not found}"
  mark "$real_ccs"                                                      "real ccs        ${real_ccs:-not found}"
  n="$( ls -1 "$MARK_DIR" 2>/dev/null | wc -l | tr -d ' ' )"
  nb="$( grep -lx 'browser=1' "$MARK_DIR"/* 2>/dev/null | wc -l | tr -d ' ' )"
  log "  info  tagged ccs sessions: ${n:-0} (with browser: ${nb:-0})"
  for s in "$BROWSER_DIR"/*; do
    [ -d "$s" ] || continue
    live=0
    for f in "$s"/leases/*; do
      [ -e "$f" ] && kill -0 "${f##*/}" 2>/dev/null && live=$((live + 1))
    done
    owned=no; [ -f "$s/owned" ] && owned=yes
    log "  info  Chrome :${s##*/}: started by shim: $owned, live --browser sessions: $live"
  done
  log "  info  'claude' resolves here to: $(command -v claude 2>/dev/null || echo none)"
}

case "${1:-}" in
  install)   cmd_install ;;
  uninstall) shift 2>/dev/null || true; cmd_uninstall "${1:-}" ;;
  status)    cmd_status ;;
  *) die "usage: herdr-ccs install | uninstall [--purge] | status" ;;
esac
